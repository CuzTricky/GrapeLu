local pages, tabButtons = {}, {}

local function selectTab(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	for n, b in pairs(tabButtons) do
		b.BackgroundColor3 = (n == name) and ACCENT or ELEM
	end
end

local function addTab(name, order)
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = ELEM,
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = TEXT,
		LayoutOrder = order,
	}, tabBar)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
	local page = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, pageHolder)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	new("UIPadding", { PaddingRight = UDim.new(0, 6) }, page)
	pages[name], tabButtons[name] = page, btn
	btn.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
	return page
end

local function addToggle(page, text, key, onChange)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = ELEM,
		BorderSizePixel = 0,
	}, page)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(52, 22),
		Position = UDim2.new(1, -60, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(60, 60, 75),
		Text = "OFF",
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = DIM,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
	local function refresh()
		btn.Text = S[key] and "ON" or "OFF"
		btn.BackgroundColor3 = S[key] and ACCENT or Color3.fromRGB(60, 60, 75)
		btn.TextColor3 = S[key] and TEXT or DIM
	end
	btn.MouseButton1Click:Connect(function()
		S[key] = not S[key]
		refresh()
		if onChange then
			pcall(onChange, S[key])
		end
	end)
	refresh()
end

local function addValue(page, text, key, min, max)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = ELEM,
		BorderSizePixel = 0,
	}, page)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
	new("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local box = new("TextBox", {
		Size = UDim2.fromOffset(52, 22),
		Position = UDim2.new(1, -60, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(50, 50, 65),
		Text = tostring(S[key]),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = TEXT,
		ClearTextOnFocus = false,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, box)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			S[key] = math.clamp(n, min, max)
		end
		box.Text = tostring(S[key])
	end)
end

local function addLabel(page, text)
	new("TextLabel", {
