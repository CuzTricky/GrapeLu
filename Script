			hum.JumpPower = S.JumpVal
		end
	end
end))

-- Noclip remembers each part's original CanCollide so turning it off restores it
local ncOrig = setmetatable({}, { __mode = "k" })
local ncActive = false

local function restoreCollisions()
	for p, v in pairs(ncOrig) do
		if p.Parent then
			p.CanCollide = v
		end
		ncOrig[p] = nil
	end
end

track(RunService.Stepped:Connect(function()
	if not running then
		return
	end
	if S.Noclip or S.Coins then
		ncActive = true
		local c = lp.Character
		if c then
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then
					if ncOrig[p] == nil then
						ncOrig[p] = p.CanCollide
					end
					p.CanCollide = false
				end
			end
		end
	elseif ncActive then
		ncActive = false
		restoreCollisions()
	end
end))

-- ========== UI ==========
local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = parent
	return i
end

local gui = Instance.new("ScreenGui")
gui.Name = "GrapeLu"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
do
