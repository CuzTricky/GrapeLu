local function selectTab(name)
	for n, b in pairs(tabButtons) do
		tween(b, { BackgroundColor3 = (n == name) and ACCENT or ELEM }, 0.15)
	end
	for n, p in pairs(pages) do
		if n == name then
			if currentTab ~= name then
				p.Position = UDim2.fromOffset(14, 0)
				p.Visible = true
				tween(p, { Position = UDim2.fromOffset(0, 0) }, 0.2)
			end
		else
			p.Visible = false
		end
	end
	currentTab = name
end

