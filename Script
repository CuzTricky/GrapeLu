-- Noclip remembers each part's original CanCollide so turning it off restores it
local ncOrig = setmetatable({}, { __mode = "k" })
local ncActive = false

local function restoreCollisions()
	for p, v in pairs(ncOrig) do
		if p.Parent then
			p.CanCollide = v
		end
		ncOrig[p] = nil
	end
end

track(RunService.Stepped:Connect(function()
	if not running then
		return
	end
	if S.Noclip or coinActive or killBusy then
		ncActive = true
		local c = lp.Character
		if c then
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then
					if ncOrig[p] == nil then
						ncOrig[p] = p.CanCollide
					end
					p.CanCollide = false
				end
			end
		end
	elseif ncActive then
		ncActive = false
		restoreCollisions()
	end
end))

-- ========== KILL ALL (Murderer only) ==========
local killActive = false

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = "GrapeLu", Text = text, Duration = 4 })
	end)
end

local function isAlive(plr)
	local ch = plr.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	return ch ~= nil and hum ~= nil and hum.Health > 0 and ch:FindFirstChild("HumanoidRootPart") ~= nil
end

local function findKnife()
	local c = lp.Character
	local bp = lp:FindFirstChild("Backpack")
	return (c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
end

local function findRemote(tool, part)
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("RemoteEvent") and string.find(string.lower(d.Name), part, 1, true) then
			return d
		end
	end
end

-- Goes after one player for up to ~1.5s. Returns true if they ended up dead.
local function killOne(plr, knife, stab, throw)
	local t0, lastThrow = os.clock(), 0
	while running and killActive and os.clock() - t0 < 1.5 do
		local hrp, hum = getHRP(), getHum()
		local ch = plr.Character
		local thrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local thum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not (hrp and hum and thrp and thum) or hum.Health <= 0 or thum.Health <= 0 then
			break
		end
		-- stand right behind them, facing them
		hrp.CFrame = CFrame.lookAt((thrp.CFrame * CFrame.new(0, 0, 2.5)).Position, thrp.Position)
		if knife.Parent ~= lp.Character then
			hum:EquipTool(knife)
		end
		if stab then
			stab:FireServer("Slash")
		end
		local handle = knife:FindFirstChild("Handle")
		if firetouchinterest and handle then
			firetouchinterest(handle, thrp, 0)
			firetouchinterest(handle, thrp, 1)
		end
		if not stab and throw and os.clock() - lastThrow > 0.35 then
			lastThrow = os.clock()
			throw:FireServer(CFrame.new(hrp.Position, thrp.Position), thrp.Position)
		end
		task.wait(0.05)
	end
	local ch = plr.Character
	local thum = ch and ch:FindFirstChildOfClass("Humanoid")
	return thum == nil or thum.Health <= 0
end

local function killAll(btn)
	if killActive then
		killActive = false -- pressing again stops it
		return
	end
	if not inMatch() or getRole(lp) ~= "Murderer" then
		notify("Kill all needs you to be the Murderer in a round.")
		return
	end
	local knife = findKnife()
	if not knife then
		notify("Couldn't find your knife.")
		return
	end
	killActive, killBusy = true, true
	if btn then
		btn.Text = "Stop kill all"
	end
	task.spawn(function()
		local kills, attempted, tries = 0, 0, {}
		pcall(function()
			local stab, throw = findRemote(knife, "stab"), findRemote(knife, "throw")
			if S.LogShots then
				print("[GrapeLu] kill all remotes:", stab, throw)
			end
			local hum = getHum()
			if hum then
				hum:EquipTool(knife)
			end
			task.wait(0.15)
			while running and killActive do
				local hrp = getHRP()
				if not hrp then
					break
				end
				-- always go for the closest living player next
				local target, best
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= lp and isAlive(plr) and (tries[plr] or 0) < 2 then
						local d = (plr.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
						if not best or d < best then
							target, best = plr, d
						end
					end
				end
				if not target then
					break
				end
				tries[target] = (tries[target] or 0) + 1
				attempted = attempted + 1
				if killOne(target, knife, stab, throw) then
					kills = kills + 1
				end
			end
		end)
		killActive, killBusy = false, false
		if btn and btn.Parent then
			btn.Text = "Kill all (Murderer)"
		end
		if kills > 0 then
			notify("Kill all finished: " .. kills .. " down.")
		elseif attempted > 0 then
			notify("Kill all didn't land any kills. Turn on Log remotes (Aim tab) and tell me what prints.")
		end
	end)
end

