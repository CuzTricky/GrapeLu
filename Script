-- Full cleanup: stops loops, disconnects events, restores the player
local function unload()
	if not running then
		return
	end
	running = false
	cancelTween()
	pcall(function()
		RunService:UnbindFromRenderStep("GrapeLuAim")
	end)
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	clearAllESP()
	restoreCollisions()
	local hum = getHum()
	if hum then
		if S.Speed then
			hum.WalkSpeed = orig.WalkSpeed
		end
		if S.Jump then
			hum.JumpPower = orig.JumpPower
		end
	end
	gui:Destroy()
	if env.GrapeLuUnload == unload then
		env.GrapeLuUnload = nil
	end
end
env.GrapeLuUnload = unload

