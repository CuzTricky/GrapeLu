-- ========== AUTO GRAB GUN ==========
local gunBusy = false
local killBusy = false
local lastDeepSearch = 0

local function findGun()
	local g = workspace:FindFirstChild("GunDrop")
	if g then
		return g
	end
	-- Slower full search, at most every 3 seconds
	if os.clock() - lastDeepSearch > 3 then
		lastDeepSearch = os.clock()
		return workspace:FindFirstChild("GunDrop", true)
	end
end

task.spawn(function()
	while running do
		local didGrab = false
		if S.Gun and inMatch() then
			pcall(function()
				local hrp = getHRP()
				local hum = getHum()
				if hrp and hum and hum.Health > 0 and getRole(lp) == "Innocent" then
					local gun = findGun()
					-- GunDrop can be a Part or a Model, handle both
					local gpart = gun and (gun:IsA("BasePart") and gun or gun:FindFirstChildWhichIsA("BasePart", true))
					if gpart and gpart.Parent then
						didGrab = true
						gunBusy = true
						local back = hrp.CFrame
						hrp.CFrame = gpart.CFrame
						if firetouchinterest then
							firetouchinterest(hrp, gpart, 0)
							firetouchinterest(hrp, gpart, 1)
						end
						task.wait(0.3)
						if hrp.Parent then
							hrp.CFrame = back
						end
					end
				end
			end)
			gunBusy = false
		end
		-- Cooldown after an attempt so a failed grab doesn't spam teleports
		task.wait(didGrab and 1.5 or 0.5)
	end
end)

-- ========== COIN COLLECTOR ==========
local visited = setmetatable({}, { __mode = "k" })
local coinActive = false
local currentTween

local function cancelTween()
	if currentTween then
		pcall(function()
			currentTween:Cancel()
		end)
		currentTween = nil
	end
end

local function nearestCoin(hrp)
	local container = getCoinContainer()
	if not container then
		return nil
	end
	local best, bestDist
	for _, c in ipairs(container:GetDescendants()) do
		if c:IsA("BasePart") and c.Name == "Coin_Server" then
			local t = visited[c]
			if not t or os.clock() - t > 15 then
				local d = (c.Position - hrp.Position).Magnitude
				if not bestDist or d < bestDist then
					best, bestDist = c, d
				end
			end
		end
	end
	return best, bestDist
end

task.spawn(function()
	while running do
		if not S.Coins then
			coinActive = false
		end
		if S.Coins and not gunBusy and not killBusy then
			pcall(function()
				if not inMatch() then
					coinActive = false
					task.wait(0.5)
					return
				end
				coinActive = true
				local hrp = getHRP()
				local hum = getHum()
				if hrp and hum and hum.Health > 0 then
					local coin, dist = nearestCoin(hrp)
					if coin then
						visited[coin] = os.clock()
						local dur = math.max(dist / S.CoinSpeed, 0.05)
						local tw = TweenService:Create(
							hrp,
							TweenInfo.new(dur, Enum.EasingStyle.Linear),
							{ CFrame = CFrame.new(coin.Position) }
						)
						currentTween = tw
						tw:Play()
						-- Wait for the tween, but bail out if toggled off, dead, or stuck
						local t0 = os.clock()
						while
							running
							and S.Coins
							and not gunBusy
							and not killBusy
							and roundOn()
							and coin.Parent
							and hrp.Parent
							and tw.PlaybackState == Enum.PlaybackState.Playing
							and os.clock() - t0 < dur + 1
						do
							task.wait()
						end
						cancelTween()
						if S.Coins and hrp.Parent and coin.Parent and firetouchinterest then
							firetouchinterest(hrp, coin, 0)
							firetouchinterest(hrp, coin, 1)
						end
						task.wait(0.1)
					else
						task.wait(0.5)
					end
				else
					task.wait(0.5)
				end
			end)
		end
		task.wait(0.05)
	end
end)

