-- ========== HELPERS ==========
local function getHRP()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRole(plr)
	local bp, ch = plr:FindFirstChild("Backpack"), plr.Character
	local function has(c, n)
		return c and c:FindFirstChild(n)
	end
	if has(bp, "Knife") or has(ch, "Knife") then
		return "Murderer"
	end
	if has(bp, "Gun") or has(ch, "Gun") then
		return "Sheriff"
	end
	return "Innocent"
end

-- ========== SHERIFF TRACKING ==========
-- The first gun holder of a round is the original sheriff. Anyone else who
-- later holds the gun picked it up (a "Hero").
local origSheriff, lastMurderer
local lastKnifeSeen = -1000

local function trackSheriff()
	local now = os.clock()
	local murderer, gunHolder
	for _, plr in ipairs(Players:GetPlayers()) do
		local r = getRole(plr)
		if r == "Murderer" then
			murderer = plr
		elseif r == "Sheriff" and not gunHolder then
			gunHolder = plr
		end
	end
	if murderer then
		lastKnifeSeen = now
		if murderer ~= lastMurderer then
			-- new murderer = new round
			lastMurderer = murderer
			origSheriff = nil
		end
	elseif now - lastKnifeSeen > 5 then
		-- no murderer for a while = lobby / between rounds
		lastMurderer = nil
		origSheriff = nil
	end
	if not origSheriff and gunHolder then
		origSheriff = gunHolder
	end
end

-- ========== ROUND DETECTION ==========
-- A round is on while a murderer exists. inMatch() also checks that YOU are
-- alive and inside the map, so lobby / spectating / dead never counts.
local function roundOn()
	return os.clock() - lastKnifeSeen < 3
end

local coinContainer, lastContainerSearch = nil, 0
local function getCoinContainer()
	if coinContainer and coinContainer.Parent then
		return coinContainer
	end
	coinContainer = nil
	if os.clock() - lastContainerSearch > 1 then
		lastContainerSearch = os.clock()
		coinContainer = workspace:FindFirstChild("CoinContainer", true)
	end
	return coinContainer
end

local function inMatch()
	local hrp, hum = getHRP(), getHum()
	if not hrp or not hum or hum.Health <= 0 then
		return false
	end
	if not roundOn() then
		return false
	end
	local container = getCoinContainer()
	local map = container and container.Parent
	if map and map:IsA("Model") then
		local ok, cf, size = pcall(map.GetBoundingBox, map)
		if ok then
			local rel = cf:PointToObjectSpace(hrp.Position)
			local half = size / 2 + Vector3.new(80, 400, 80)
			if math.abs(rel.X) > half.X or math.abs(rel.Y) > half.Y or math.abs(rel.Z) > half.Z then
				return false
			end
		end
	end
	return true
end

-- ========== ESP ==========
local espObjs = {}

local function clearESP(plr)
	local o = espObjs[plr]
	if o then
		if o.hl then
			o.hl:Destroy()
		end
		if o.bb then
			o.bb:Destroy()
		end
		espObjs[plr] = nil
	end
end

local function clearAllESP()
	for plr in pairs(espObjs) do
		clearESP(plr)
	end
end

local function updateOneESP(plr)
	do
		if plr ~= lp then
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local head = ch and ch:FindFirstChild("Head")
			if S.ESP and ch and hum and hum.Health > 0 and head then
				local role = getRole(plr)
				if role == "Sheriff" and origSheriff and plr ~= origSheriff then
					role = "Hero"
				end
				local o = espObjs[plr]
				if not o or not o.hl.Parent or not o.bb.Parent or o.char ~= ch then
					clearESP(plr)
					local hl = Instance.new("Highlight")
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Adornee = ch
					hl.Parent = ch

					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(120, 30)
					bb.StudsOffset = Vector3.new(0, 2.5, 0)
					bb.AlwaysOnTop = true
					bb.Adornee = head
					bb.Parent = head
					local tl = Instance.new("TextLabel")
					tl.Size = UDim2.fromScale(1, 1)
					tl.BackgroundTransparency = 1
					tl.Font = Enum.Font.GothamBold
					tl.TextSize = 13
					tl.TextStrokeTransparency = 0.4
					tl.Parent = bb

					o = { hl = hl, bb = bb, tl = tl, char = ch }
					espObjs[plr] = o
				end
				o.hl.FillColor = COLORS[role]
				o.hl.OutlineColor = COLORS[role]
				o.tl.TextColor3 = COLORS[role]
				o.bb.Enabled = S.ESPNames
				o.tl.Text = plr.DisplayName .. " [" .. role .. "]"
			else
				clearESP(plr)
			end
		end
	end
end

local function updateESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(updateOneESP, plr)
	end
end

track(Players.PlayerRemoving:Connect(clearESP))

