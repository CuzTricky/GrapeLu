-- ========== STATE ==========
local running = true
local conns = {}

local function track(c)
	conns[#conns + 1] = c
	return c
end

local S = {
	ESP = false,
	ESPNames = true,
	Coins = false,
	CoinSpeed = 28,
	Gun = false,
	Speed = false,
	SpeedVal = 24,
	Jump = false,
	JumpVal = 60,
	Noclip = false,
}

-- Values to restore when a toggle is switched off
local orig = { WalkSpeed = 16, JumpPower = 50 }

local COLORS = {
	Murderer = Color3.fromRGB(255, 60, 60),
	Sheriff = Color3.fromRGB(70, 140, 255),
	Innocent = Color3.fromRGB(70, 220, 120),
}

-- ========== HELPERS ==========
local function getHRP()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRole(plr)
	local bp, ch = plr:FindFirstChild("Backpack"), plr.Character
	local function has(c, n)
		return c and c:FindFirstChild(n)
	end
	if has(bp, "Knife") or has(ch, "Knife") then
		return "Murderer"
	end
	if has(bp, "Gun") or has(ch, "Gun") then
		return "Sheriff"
	end
	return "Innocent"
end

-- ========== ESP ==========
local espObjs = {}

local function clearESP(plr)
	local o = espObjs[plr]
	if o then
		if o.hl then
			o.hl:Destroy()
		end
		if o.bb then
			o.bb:Destroy()
		end
		espObjs[plr] = nil
	end
end

local function clearAllESP()
	for plr in pairs(espObjs) do
		clearESP(plr)
	end
end

local function updateESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local head = ch and ch:FindFirstChild("Head")
			if S.ESP and ch and hum and hum.Health > 0 and head then
				local role = getRole(plr)
				local o = espObjs[plr]
				if not o or not o.hl.Parent or not o.bb.Parent or o.char ~= ch then
					clearESP(plr)
					local hl = Instance.new("Highlight")
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Adornee = ch
					hl.Parent = ch

					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(120, 30)
					bb.StudsOffset = Vector3.new(0, 2.5, 0)
					bb.AlwaysOnTop = true
					bb.Adornee = head
					bb.Parent = head
					local tl = Instance.new("TextLabel")
					tl.Size = UDim2.fromScale(1, 1)
					tl.BackgroundTransparency = 1
					tl.Font = Enum.Font.GothamBold
					tl.TextSize = 13
					tl.TextStrokeTransparency = 0.4
					tl.Parent = bb

					o = { hl = hl, bb = bb, tl = tl, char = ch }
					espObjs[plr] = o
				end
				o.hl.FillColor = COLORS[role]
				o.hl.OutlineColor = COLORS[role]
				o.tl.TextColor3 = COLORS[role]
				o.bb.Enabled = S.ESPNames
				o.tl.Text = plr.DisplayName .. " [" .. role .. "]"
			else
				clearESP(plr)
			end
		end
	end
end

track(Players.PlayerRemoving:Connect(clearESP))

task.spawn(function()
	while running do
		pcall(updateESP)
		task.wait(0.4)
	end
end)

-- ========== AUTO GRAB GUN ==========
local lastDeepSearch = 0

local function findGun()
	local g = workspace:FindFirstChild("GunDrop")
	if g then
		return g
	end
	-- Slower full search, at most every 3 seconds
	if os.clock() - lastDeepSearch > 3 then
		lastDeepSearch = os.clock()
		return workspace:FindFirstChild("GunDrop", true)
	end
end

task.spawn(function()
	while running do
		local didGrab = false
		if S.Gun then
			pcall(function()
				local hrp = getHRP()
				local hum = getHum()
				if hrp and hum and hum.Health > 0 and getRole(lp) == "Innocent" then
					local gun = findGun()
					if gun and gun.Parent and gun:IsA("BasePart") then
						didGrab = true
						local back = hrp.CFrame
						hrp.CFrame = gun.CFrame
						if firetouchinterest then
							firetouchinterest(hrp, gun, 0)
							firetouchinterest(hrp, gun, 1)
						end
						task.wait(0.3)
						if hrp.Parent then
							hrp.CFrame = back
						end
					end
				end
			end)
		end
		-- Cooldown after an attempt so a failed grab doesn't spam teleports
		task.wait(didGrab and 1.5 or 0.5)
	end
end)

-- ========== COIN COLLECTOR ==========
local visited = setmetatable({}, { __mode = "k" })
local currentTween

local function cancelTween()
	if currentTween then
		pcall(function()
			currentTween:Cancel()
		end)
		currentTween = nil
	end
end

local function nearestCoin(hrp)
	local container = workspace:FindFirstChild("CoinContainer", true)
	if not container then
		return nil
	end
	local best, bestDist
	for _, c in ipairs(container:GetDescendants()) do
		if c:IsA("BasePart") and c.Name == "Coin_Server" then
			local t = visited[c]
			if not t or os.clock() - t > 6 then
				local d = (c.Position - hrp.Position).Magnitude
				if not bestDist or d < bestDist then
					best, bestDist = c, d
				end
			end
		end
	end
	return best, bestDist
end

task.spawn(function()
	while running do
		if S.Coins then
			pcall(function()
				local hrp = getHRP()
				local hum = getHum()
				if hrp and hum and hum.Health > 0 then
					local coin, dist = nearestCoin(hrp)
					if coin then
						visited[coin] = os.clock()
						local dur = math.max(dist / S.CoinSpeed, 0.05)
						local tw = TweenService:Create(
							hrp,
							TweenInfo.new(dur, Enum.EasingStyle.Linear),
							{ CFrame = CFrame.new(coin.Position) }
						)
						currentTween = tw
						tw:Play()
						-- Wait for the tween, but bail out if toggled off, dead, or stuck
						local t0 = os.clock()
						while
							running
							and S.Coins
							and hrp.Parent
							and tw.PlaybackState == Enum.PlaybackState.Playing
							and os.clock() - t0 < dur + 1
						do
							task.wait()
						end
						cancelTween()
						if S.Coins and hrp.Parent and coin.Parent and firetouchinterest then
							firetouchinterest(hrp, coin, 0)
							firetouchinterest(hrp, coin, 1)
						end
						task.wait(0.1)
					else
						task.wait(0.5)
					end
				else
					task.wait(0.5)
				end
			end)
		end
		task.wait(0.05)
	end
end)

-- ========== MOVEMENT ==========
track(RunService.Heartbeat:Connect(function()
