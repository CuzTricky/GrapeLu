-- Config tab
local configPage = addTab("Config", 5)

local HttpService = game:GetService("HttpService")
local CONFIG_DIR = "GrapeLu"
local AUTOLOAD_FILE = CONFIG_DIR .. "/_autoload.txt"
local hasFS = (writefile and readfile and isfile) ~= nil
local cfgName = "default"
local cfgListLabel
local nameBox

local function cleanName(n)
	local cleaned = tostring(n or ""):gsub("[^%w_%-]", "")
	if cleaned == "" then
		cleaned = "default"
	end
	return string.sub(cleaned, 1, 24)
end

local function cfgPath(name)
	return CONFIG_DIR .. "/" .. name .. ".json"
end

local function ensureDir()
	if makefolder and isfolder and not isfolder(CONFIG_DIR) then
		pcall(makefolder, CONFIG_DIR)
	end
end

local function listConfigs()
	local names = {}
	if hasFS and listfiles and isfolder and isfolder(CONFIG_DIR) then
		pcall(function()
			for _, f in ipairs(listfiles(CONFIG_DIR)) do
				local n = string.match(f, "([^/\\]+)%.json$")
				if n then
					names[#names + 1] = n
				end
			end
		end)
	end
	table.sort(names)
	return names
end

local function refreshList()
	if not cfgListLabel then
		return
	end
	if not hasFS then
		cfgListLabel.Text = "Your executor can't read or write files, so configs are unavailable."
		return
	end
	local names = listConfigs()
	cfgListLabel.Text = "Saved configs: " .. (#names > 0 and table.concat(names, ", ") or "none")
end

local function saveConfig(name)
	if not hasFS then
		notify("Your executor can't save files.")
		return
	end
	ensureDir()
	local data = {}
	for key in pairs(uiApply) do
		if key ~= "AutoLoad" then
			data[key] = S[key]
		end
	end
	local ok = pcall(function()
		writefile(cfgPath(name), HttpService:JSONEncode(data))
		if S.AutoLoad then
			writefile(AUTOLOAD_FILE, name)
		end
	end)
	notify(ok and ("Saved config '" .. name .. "'.") or "Couldn't save the config.")
	refreshList()
end

local function loadConfig(name, quiet)
	if not hasFS or not isfile(cfgPath(name)) then
		if not quiet then
			notify("No config named '" .. name .. "'.")
		end
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(cfgPath(name)))
	end)
	if not ok or type(data) ~= "table" then
		notify("That config file is broken.")
		return false
	end
	for key, v in pairs(data) do
		if key ~= "AutoLoad" and uiApply[key] then
			pcall(uiApply[key], v)
		end
	end
	if not quiet then
		notify("Loaded config '" .. name .. "'.")
	end
	return true
end

local function deleteConfig(name)
	if not hasFS or not delfile or not isfile(cfgPath(name)) then
		notify("No config named '" .. name .. "'.")
		return
	end
	pcall(delfile, cfgPath(name))
	notify("Deleted config '" .. name .. "'.")
	refreshList()
end

local function resetDefaults()
	for key, v in pairs(DEFAULTS) do
		if key ~= "AutoLoad" and uiApply[key] then
			pcall(uiApply[key], v)
		end
	end
	notify("Settings reset to defaults.")
end

nameBox = addTextBox(configPage, "Config name", cfgName, function(text)
	cfgName = cleanName(text)
	return cfgName
end)
addButton(configPage, "Save config", function()
	saveConfig(cfgName)
end)
addButton(configPage, "Load config", function()
	loadConfig(cfgName)
end)
addButton(configPage, "Delete config", function()
	deleteConfig(cfgName)
end, Color3.fromRGB(150, 45, 55))
addToggle(configPage, "Auto-load on start", "AutoLoad", function(on)
	if not hasFS then
		notify("Your executor can't save files.")
		return false
	end
	ensureDir()
	if on then
		pcall(writefile, AUTOLOAD_FILE, cfgName)
		notify("Will auto-load '" .. cfgName .. "' next time.")
	elseif delfile and isfile(AUTOLOAD_FILE) then
		pcall(delfile, AUTOLOAD_FILE)
	end
end)
addButton(configPage, "Reset to defaults", function()
	resetDefaults()
end)
cfgListLabel = addLabel(configPage, "", 40)
refreshList()

-- Auto-load the saved config on start
if hasFS and isfile(AUTOLOAD_FILE) then
	local ok, saved = pcall(readfile, AUTOLOAD_FILE)
	if ok and type(saved) == "string" then
		cfgName = cleanName(saved)
		nameBox.Text = cfgName
		if loadConfig(cfgName, true) then
			S.AutoLoad = true
			uiApply.AutoLoad(true)
			notify("Auto-loaded config '" .. cfgName .. "'.")
		end
	end
end

