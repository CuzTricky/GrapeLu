-- Smooth show / hide
local menuOpen = true
local menuToken = 0
local function setMenuVisible(v)
	menuOpen = v
	menuToken = menuToken + 1
	local my = menuToken
	if v then
		icon.Visible = false
		main.Visible = true
		scale.Scale = 0.9
		tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	else
		tween(scale, { Scale = 0.9 }, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.16, function()
			if menuToken == my then
				main.Visible = false
				icon.Visible = true
				iconScale.Scale = 0.5
				tween(iconScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
			end
		end)
	end
end

-- Icon dragging (a tap without movement reopens the menu)
do
	local dragging, moved, startPos, startInput
	icon.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startPos, startInput = icon.Position, input.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved then
						setMenuVisible(true)
					else
						-- keep the icon on screen
						local vp = gui.AbsoluteSize
						local ap = icon.AbsolutePosition
						local half = icon.AbsoluteSize.X / 2
						local cx = math.clamp(ap.X + half, half, vp.X - half)
						local cy = math.clamp(ap.Y + half, half, vp.Y - half)
						tween(icon, { Position = UDim2.fromOffset(cx, cy) }, 0.15)
					end
				end
			end)
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
		then
			local d = input.Position - startInput
			if d.Magnitude > 6 then
				moved = true
			end
			if moved then
				icon.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + d.X,
					startPos.Y.Scale,
					startPos.Y.Offset + d.Y
				)
			end
		end
	end))
end

