local function addToggle(page, text, key, onChange)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = ELEM,
		BorderSizePixel = 0,
	}, page)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local OFFC = Color3.fromRGB(60, 60, 75)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(40, 20),
		Position = UDim2.new(1, -50, 0.5, -10),
		BackgroundColor3 = OFFC,
		Text = "",
		AutoButtonColor = false,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, btn)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = DIM,
		BorderSizePixel = 0,
	}, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	hoverFx(row, ELEM, ROWHOVER)
	local function refresh(animate)
		local on = S[key]
		local t = animate and 0.18 or 0
		tween(btn, { BackgroundColor3 = on and ACCENT or OFFC }, t)
		tween(knob, {
			Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = on and TEXT or DIM,
		}, t, Enum.EasingStyle.Back)
	end
	btn.MouseButton1Click:Connect(function()
		S[key] = not S[key]
		if onChange then
			local ok, res = pcall(onChange, S[key])
			if ok and res == false then
				S[key] = false -- feature unavailable, snap back to OFF
			end
		end
		refresh(true)
	end)
	refresh(false)
	uiApply[key] = function(v)
		if type(v) ~= "boolean" then
			return
		end
		if S[key] == v then
			refresh(true)
			return
		end
		S[key] = v
		if onChange then
			local ok, res = pcall(onChange, v)
			if ok and res == false then
				S[key] = false
			end
		end
		refresh(true)
	end
end

