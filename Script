RunService:BindToRenderStep("GrapeLuAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not running then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	local aimOn = S.Aim or S.Silent
	local c = aimCenter(cam)
	fovCircle.Visible = S.ShowFOV and S.Aim
	fovCircle.Size = UDim2.fromOffset(S.AimFOV * 2, S.AimFOV * 2)
	fovCircle.Position = UDim2.fromOffset(c.X, c.Y)
	silentCircle.Visible = S.ShowFOV and S.Silent
	silentCircle.Size = UDim2.fromOffset(S.SilentFOV * 2, S.SilentFOV * 2)
	silentCircle.Position = UDim2.fromOffset(c.X, c.Y)

	silentPos, silentPart = nil, nil
	if aimOn and holdingWeapon() then
		if S.Aim then
			local pos = getAimTarget(cam, S.AimFOV, false)
			if pos then
				local holding = not S.AimHold
					or not UserInputService.MouseEnabled
					or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
				if holding then
					local goal = CFrame.lookAt(cam.CFrame.Position, pos)
					cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(S.AimSmooth / 100, 0.01, 1))
				end
			end
		end
		if S.Silent then
			silentPos, silentPart = getAimTarget(cam, S.SilentFOV, not S.SilentStrict)
		end
	end
end)

-- Silent aim, based on how MM2 really sends shots:
--   Sheriff: remote "ShootGun" (InvokeServer), aim position is argument 2
--   Murderer: remote "Throw" (FireServer), aim position is argument 2
-- So we rewrite the aim position of those remotes. Mouse.Hit / Mouse.Target are
-- redirected as a backup. Works with hookmetamethod, or the raw metatable if your
-- executor doesn't have it.
local hasHook = false
local remoteLogT = {}
local safeCheck = checkcaller or function()
	return false
end
local wrapC = newcclosure or function(f)
	return f
end

local function installHook(metaName, handler)
	if hookmetamethod then
		local old
		old = hookmetamethod(game, metaName, wrapC(function(...)
			return handler(old, ...)
		end))
		return true
	end
	if getrawmetatable then
		local mt = getrawmetatable(game)
		local old = mt[metaName]
		local wasRO = isreadonly and isreadonly(mt)
		if setreadonly then
			setreadonly(mt, false)
		elseif make_writeable then
			make_writeable(mt)
		end
		mt[metaName] = wrapC(function(...)
			return handler(old, ...)
		end)
		if setreadonly and wasRO ~= false then
			setreadonly(mt, true)
		end
		return true
	end
	return false
end

local function shotTarget()
	if silentPos then
		return silentPos
	end
	-- the render loop had nothing cached, so look again right now
	local cam = workspace.CurrentCamera
	if cam then
		return (getAimTarget(cam, S.SilentFOV, not S.SilentStrict))
	end
end

pcall(function()
	-- Main one: rewrite the aim position of the shoot / throw remotes
	if getnamecallmethod then
		local ok = installHook("__namecall", function(old, self, ...)
			local method = getnamecallmethod()
			if running and S.Silent and (method == "FireServer" or method == "InvokeServer") and not safeCheck() then
				local cls = self.ClassName
				if cls == "RemoteEvent" or cls == "RemoteFunction" then
					local name = self.Name
					local lname = string.lower(name)
					if S.LogShots then
						local t = os.clock()
						if not remoteLogT[name] or t - remoteLogT[name] > 0.5 then
							remoteLogT[name] = t
							print("[GrapeLu] remote:", name, method, ...)
						end
					end
					local isShot = lname == "shootgun"
						or lname == "throw"
						or string.find(lname, "shoot", 1, true)
						or string.find(lname, "throw", 1, true)
					if isShot then
						local target = shotTarget()
						if target then
							local args = table.pack(...)
							local changed = 0
							for i = 1, args.n do
								if typeof(args[i]) == "Vector3" then
									args[i] = target
									changed = changed + 1
								end
							end
							if changed == 0 then
								-- no Vector3 aim argument: rewrite a CFrame that points far from you
								local hrp = getHRP()
								for i = 1, args.n do
									local a = args[i]
									if typeof(a) == "CFrame" and hrp and (a.Position - hrp.Position).Magnitude > 6 then
										args[i] = CFrame.new(target)
										changed = changed + 1
									end
								end
							end
							if changed > 0 then
								if S.LogShots then
									print("[GrapeLu] silent aim redirected", name)
								end
								if setnamecallmethod then
									setnamecallmethod(method)
								end
								return old(self, table.unpack(args, 1, args.n))
							end
						end
					end
				end
			end
			return old(self, ...)
		end)
		if ok then
			hasHook = true
		end
	end
end)

