-- ========== AIM ASSIST / SILENT AIM ==========
-- Role based: as Sheriff it targets the Murderer, as Murderer it targets everyone else.
-- Only active while you are holding your Gun or Knife.
local mouse = lp:GetMouse()
local silentPos, silentPart

local function holdingWeapon()
	local c = lp.Character
	return c ~= nil and (c:FindFirstChild("Gun") ~= nil or c:FindFirstChild("Knife") ~= nil)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(cam, part, targetChar)
	local excl = { targetChar }
	if lp.Character then
		excl[#excl + 1] = lp.Character
	end
	rayParams.FilterDescendantsInstances = excl
	local origin = cam.CFrame.Position
	for _ = 1, 6 do
		local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
		if not hit then
			return true
		end
		local inst = hit.Instance
		if inst.CanCollide and inst.Transparency < 0.8 then
			-- another player's body in the way doesn't count as a wall
			local model = inst:FindFirstAncestorOfClass("Model")
			if not (model and Players:GetPlayerFromCharacter(model)) then
				return false
			end
		end
		-- see-through / non-solid / a player: ignore it and keep tracing
		excl[#excl + 1] = inst
		rayParams.FilterDescendantsInstances = excl
		origin = hit.Position
	end
	return true
end

local function aimCenter(cam)
	if UserInputService.MouseEnabled then
		return UserInputService:GetMouseLocation()
	end
	return cam.ViewportSize / 2
end

local function getAimTarget(cam, fov, allowFallback)
	local myRole = getRole(lp)
	if myRole ~= "Sheriff" and myRole ~= "Murderer" then
		return nil
	end
	local center = aimCenter(cam)
	local bestPos, bestPart, bestDist = nil, nil, fov
	local farPos, farPart, farDist
	for _, plr in ipairs(Players:GetPlayers()) do
		local ch = plr ~= lp and plr.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local part = ch and ch:FindFirstChild(S.AimHead and "Head" or "HumanoidRootPart")
		if hum and part and hum.Health > 0 and (myRole == "Murderer" or getRole(plr) == "Murderer") then
			-- lead the target using horizontal speed only (jumping/falling would throw it off)
			local vel = part.AssemblyLinearVelocity
			local pos = part.Position + Vector3.new(vel.X, 0, vel.Z) * (S.Predict / 100)
			local sp, onScreen = cam:WorldToViewportPoint(part.Position)
			local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
			if onScreen and d < bestDist then
				if not S.AimWall or isVisible(cam, part, ch) then
					bestDist, bestPos, bestPart = d, pos, part
				end
			elseif allowFallback then
				-- outside the circle / off-screen: silent aim still takes the closest one
				local wd = (part.Position - cam.CFrame.Position).Magnitude
				if (not farDist or wd < farDist) and (not S.AimWall or isVisible(cam, part, ch)) then
					farDist, farPos, farPart = wd, pos, part
				end
			end
		end
	end
	if bestPos then
		return bestPos, bestPart
	end
	return farPos, farPart
end

